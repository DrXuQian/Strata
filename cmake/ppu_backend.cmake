# The PPU SDK provides the CUDA runtime and cuBLAS-compatible ACBLAS entrypoints.
# NCP kernels are independently built .so files; no CUTLASS/Torch headers are used.
option(STRATA_ENABLE_PPU "Build the Qwen Flash-Next PPU backend (CUDA-compatible SDK + NCP)" OFF)
option(STRATA_NCP_FA "Use libncp_fa.so for QSA prompt attention" ${STRATA_ENABLE_PPU})
option(STRATA_NCP_MOE "Use libncp_moe.so for prompt expert GEMMs" ${STRATA_ENABLE_PPU})
option(STRATA_NCP_GDN "Use libncp_gdn.so for GDN recurrence" ${STRATA_ENABLE_PPU})

if(NOT STRATA_ENABLE_PPU)
  if(STRATA_NCP_FA OR STRATA_NCP_MOE OR STRATA_NCP_GDN)
    message(FATAL_ERROR "STRATA_NCP_FA/MOE/GDN require STRATA_ENABLE_PPU=ON")
  endif()
  return()
endif()

if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "STRATA_ENABLE_PPU currently requires Linux (NCP .so loader)")
endif()
if(STRATA_ENABLE_HIP OR STRATA_HIP_GFX906 OR STRATA_ENABLE_SYCL)
  message(FATAL_ERROR "STRATA_ENABLE_PPU cannot be combined with HIP or SYCL")
endif()
if(STRATA_BUILD_DSV41 OR STRATA_BUILD_SPLIT)
  message(FATAL_ERROR "The PPU backend currently targets Qwen Flash-Next; DSV41 and strata-split are not admitted")
endif()
if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES AND DEFINED ENV{CUDAARCHS})
  set(CMAKE_CUDA_ARCHITECTURES "$ENV{CUDAARCHS}" CACHE STRING "CUDA architectures")
endif()
if(NOT CMAKE_CUDA_ARCHITECTURES OR CMAKE_CUDA_ARCHITECTURES MATCHES "native|all")
  message(FATAL_ERROR "PPU requires an explicit CMAKE_CUDA_ARCHITECTURES supported by the selected SDK; no NVIDIA auto-detection")
endif()
foreach(_ppu_arch IN LISTS CMAKE_CUDA_ARCHITECTURES)
  if(NOT _ppu_arch MATCHES "^(80|89|90a?)(-real|-virtual)?$")
    message(FATAL_ERROR "Unreviewed PPU CUDA target '${_ppu_arch}'; select the target supported by your PPU SDK")
  endif()
endforeach()

set(STRATA_ENABLE_CUDA ON)
add_compile_definitions(STRATA_USE_PPU=1)
foreach(_feature FA MOE GDN)
  if(STRATA_NCP_${_feature})
    add_compile_definitions(STRATA_NCP_${_feature}=1)
  endif()
endforeach()
list(APPEND CMAKE_BUILD_RPATH "$ORIGIN")
list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN")
message(STATUS "Strata PPU: FA=${STRATA_NCP_FA}, MoE=${STRATA_NCP_MOE}, GDN=${STRATA_NCP_GDN}; target=${CMAKE_CUDA_ARCHITECTURES}")
message(STATUS "Strata PPU: quantized prompt GEMMs use dequantization + ACBLAS/NCP; NVIDIA MMQ is disabled")
